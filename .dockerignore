# Keep Docker build contexts small: every service Dockerfile uses the repo
# root as context (the pnpm workspace needs the root lockfile), so anything
# not excluded here uploads on every build.
.git
**/node_modules
**/.next
**/.turbo
**/dist
**/.expo
**/coverage
.builders
**/.DS_Store
**/.env
**/.env.local
**/.env.*.local
apps/frontend/google-service-account
# Cloudflare Worker local state and secrets (apps/mcp)
**/.dev.vars
**/.dev.vars.*
**/.wrangler
**/dist-worker

# Credentials and private environment files; committed public examples remain available.
**/.npmrc
**/.env.*
!**/.env.ci
!**/.env.example
**/test-results
**/playwright-report
