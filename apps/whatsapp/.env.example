# Copy this file to .env (apps/whatsapp/.env) and fill in the values. Never commit .env.
# Real environment variables (Railway) win over the file.
#
# Every variable keeps the name it had in legacy/whatsapp, so values already set on Railway
# work unchanged. src/config.ts validates all of this at start-up and names each bad variable.
#
# Booleans: write True or False (also accepted: true, false, 1, 0, the same as apps/api's MAINTENANCE_MODE).
# Anything else, such as yes, on or TRUE, stops start-up with an error naming the variable.

# Where the service is deployed: local, development, staging or production.
# - local: the only environment where the MOCK_* switches may be used.
# - production: META_REPLY_BY_PHONE is refused.
# - everything but local and development logs one JSON object per line (Railway's format).
DEPLOYMENT_TYPE="local"

# The port to listen on. Railway sets this itself; do not set it there.
# 3200 follows apps/api (3000) and apps/auth (3100). Local zrok tunnels must point here.
PORT="3200"

# Sentry DSN for error tracking.
# 1. Log in at https://sentry.io, select your organization and project
# 2. Settings > Projects > [Your Project Name] > Client Keys (DSN)
# 3. Copy the DSN (https://xxxxx@xxxxx.ingest.sentry.io/xxxxx)
# Leave empty or omit to disable Sentry.
SENTRY_DSN=""

###################################### Related to apps/api and apps/auth ######################################

# apps/api's base URL (WITHOUT any path). The client appends /api/v2/* to it.
# if local: "http://localhost:3000"
BACKEND_SERVER_URL="http://localhost:3000"

# apps/auth's base URL (WITHOUT any path). The auth client appends /api/whatsapp/session to it.
# if local: "http://localhost:3100"
AUTH_SERVER_URL="http://localhost:3100"

# API key that authenticates this service to apps/auth's /whatsapp endpoint.
# Sent as `Authorization: Bearer <key>` (issue #329). MUST be a key issued by apps/auth for this service.
AUTH_WHATSAPP_API_KEY="your_generated_secret_key_here"

###################################### Related to CORS ######################################

# Comma-separated origins allowed to call this service. Usually not needed: BACKEND_SERVER_URL,
# "testserver" (GitHub Actions) and https://web.whatsapp.com are added automatically.
ORIGINS="https://api.ansari.chat,https://web.whatsapp.com"

###################################### Related to WhatsApp Business and Meta ######################################

# Preface: you might be asking yourself: "ALL OF THESE CONFIGS JUST TO SET UP WHATSAPP?!"
#   Yes :'D Meta's API/setup process is a bit complicated, which is why BSPs exist.
#   https://www.reddit.com/r/WhatsappBusinessAPI/comments/1mwa0r6/difference_between_using_meta_whatsapp_cloud_api/
#   We decided to do it the old-fashioned way: straight to the main API.

# Source 0: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# Source 1: https://www.youtube.com/watch?v=KP6_BUw3i0U
#   Watch until 32:25, skimming past the non-TypeScript code parts (the video's code is Python/Node)
# Source 2 (from the video): https://glitch.com/edit/#!/insidious-tartan-alvarezsaurus
#   (the GET /whatsapp/v3 verification handshake in src/app.ts follows the same idea)

# Testing the webhook locally (information only: this service does not read any variable for it).
# Meta needs a public URL, so a reserved zrok share forwards one to your machine. You need a zrok
# "share token" from its current holder: https://github.com/OdyAsh (sources 1 and 2).
# Alternatively, change the webhook URL altogether (sources 3 and 4).
#   Source 1: https://dev.to/odyash/quickly-share-your-app-with-zrok-4ihp
#   Source 2: https://openziti.discourse.group/t/how-do-i-use-a-reserved-share-on-different-devices/2379/2
#   Source 3: https://youtu.be/KP6_BUw3i0U?t=1294
#     (@21:33 and 25:30; they use glitch instead of zrok, so it only shows how to set up a webhook)
#   Source 4 (where you change the callback URL, if the app's admins gave your Facebook account access):
#     https://developers.facebook.com/apps/871020755148175/whatsapp-business/wa-settings/
#     NOTE 1: 871020755148175 is the test app's public id. If the link still fails after you get access,
#     the admins most probably created a new test app.
#     NOTE 2: the Callback URL looks like "https://<ZROK-SHARE-TOKEN>.share.zrok.io/whatsapp/v3"
#       This zrok URL is only for the "Ansari - Test" app, so use it only for local development,
#       never in staging or production. (Python used /whatsapp/v2; the TypeScript service serves /whatsapp/v3.)
#     NOTE 3: if a third party discovers the share token, generate a new one and put it in the callback URL of the
#       *test* app. (The production app's callback URL differs, so that party cannot reach it, but we still do not
#       want random calls hitting the test app.)
#   The reserved share maps to your local port. To change it, release and reserve again:
#     zrok release <ZROK-SHARE-TOKEN>
#     zrok reserve public localhost:3200 --unique-name "<ZROK-SHARE-TOKEN>"
#   (3200 is the PORT above; the Python service used 8001.)
#   Why this is not a setting here: the Python config read META_WEBHOOK_ZROK_SHARE_TOKEN only to add
#   "<token>.share.zrok.io" to the CORS allow-list in local mode. Meta's webhooks are server-to-server and send no
#   Origin header, so the entry did nothing and was not ported.

META_API_VERSION="v26.0"

# Phone number ID (from the Meta dashboard)
# NOTE 1: contact the team to see WhatsApp's 2 phone numbers: one for production, one for local/staging testing.
# NOTE 2: if you get this error:
#   "Client error '400 Bad Request' for url 'https://graph.facebook.com/v26.0/<META_BUSINESS_PHONE_NUMBER_ID>/messages'"
#   then either:
#     (1) Meta deleted the phone number id after long inactivity. Open source 1's video @6:11. Under "step 1" in the
#         middle of the page, click the selection box with the live WhatsApp number, then "Get new test number".
#         Wait a while, then copy the new number's id into META_BUSINESS_PHONE_NUMBER_ID.
#     (2) Meta updated its API version and META_API_VERSION is outdated. Check source 1 @26:13 for the version
#         shown next to `messages`.
#     (3) you sent a message in an incorrect format. Check source 1, 26:10 -> 26:28, and click `messages`.
#   Reference: https://developers.facebook.com/docs/whatsapp/cloud-api/reference/messages
META_BUSINESS_PHONE_NUMBER_ID="your_phone_number_id_here"

# System User access token (from the Meta dashboard)
# NOTE 1: source 1's video, 30:45 -> 32:15, shows where the access token comes from.
# NOTE 2: contact the team for their 3 access tokens: production app (Ansari), staging app (Ansari - Staging)
#   and local/dev app (Ansari - Test).
# NOTE 3: to debug a token, open https://developers.facebook.com/tools/debug/accesstoken/?access_token=<YOUR-ACCESS-TOKEN>
META_ACCESS_TOKEN_FROM_SYS_USER="your_access_token_here"

# Token for webhook verification (from the Meta dashboard): Meta sends it in the GET handshake and the service
# compares it in constant time.
META_WEBHOOK_VERIFY_TOKEN="<<The-VERIFY-TOKEN-CURRENTLY-USED-TO-VERIFY-META'S-CALLBACK-URL>>"

# Meta App Secret, used to verify the X-Hub-Signature-256 header on incoming webhooks, so only Meta can trigger
# the service. There is deliberately no default: a public default would let anyone forge signed webhooks.
# References:
# - https://developers.facebook.com/docs/graph-api/webhooks/getting-started#validate-payloads
# - https://developers.facebook.com/docs/facebook-login/security/
# - https://stackoverflow.com/questions/76898751/how-to-find-app-secret-for-whatsapp-business-api
# Location: https://developers.facebook.com/ -> My Apps -> your app -> App Settings -> Basic -> App Secret ("Show")
# "Your app" is one of "Ansari - Test", "Ansari - Staging" or "Ansari". "Ansari - Test" is the one used for
# local development with a zrok webhook URL.
META_ANSARI_APP_SECRET="your_app_secret_here"

# Address replies to the sender's phone number instead of their BSUID. Only for Meta's free test number, whose
# allowed-recipient list holds phone numbers, so it cannot message a BSUID (error 131030). A real number accepts
# BSUID replies. The service refuses to start with this set when DEPLOYMENT_TYPE=production.
META_REPLY_BY_PHONE="False"

# Meta Messaging account ID (what Meta used to call the "WhatsApp Business Account", or WABA, ID).
# Not read by the service itself (nothing in src/ uses it). Only the operator script reads it, and you run that by hand:
#   pnpm whatsapp meta:subscriptions
#
# Old vs new account model (Meta is moving every account over between 23 Sep and 15 Oct 2026):
#   Old: one "WhatsApp Business account" held the phone number, the message templates and the billing together,
#        and could be connected to only one integration at a time.
#   New: it is split in two.
#        - WhatsApp account: owns the phone number (display name, quality, messaging limits). It can be shared
#          with several integrations at once.
#        - Messaging account: owns the templates and billing, with one per integration. This is the ID we want.
#   Source: https://www.facebook.com/business/help/1082831781117070
#
# Why the script needs it: Meta's subscription endpoint (GET/POST/DELETE /<ID>/subscribed_apps) takes this ID, and a
# webhook only reaches the Meta apps subscribed to it. When messages to META_BUSINESS_PHONE_NUMBER_ID do not arrive,
# the script lists the subscribed apps (e.g. "Ansari - Staging") and can subscribe or unsubscribe the app your access
# token belongs to. It also shows the token's app and expiry, and lists the phone numbers. The script reads
# META_ACCESS_TOKEN_FROM_SYS_USER from this file too, and never prints it. (Meta's docs may still say "WABA ID"; same value.)
#
# Two alternative methods to find it (it is not secret, but it differs per Messaging account):
#   1) developers.facebook.com: https://developers.facebook.com/apps/ -> your app -> WhatsApp -> "Step 1. Try it out"
#      -> "Claim a WhatsApp test number" section -> "Messaging account ID". For the production number instead, open
#      "Step 2. Production setup" -> "Register your WhatsApp phone number" and read it under "Ansari Chat".
#   2) business.facebook.com: https://business.facebook.com/ -> left side, under "Accounts" click "Messaging accounts"
#      -> choose the one to inspect (e.g. "Test Messaging Account" or "Ansari Chat") -> its "ID" is shown directly
#      below its name.
# Leave it out if you never run the script; the script also asks for it when it starts.
# META_MESSAGING_ACCOUNT_ID="your_messaging_account_id_here"

# Meta Developer App ID of the app whose access token and app secret are used above. NOT read by the service or the
# script. It is only a reference, to remember which app ("Ansari - Test", "Ansari - Staging" or "Ansari") the credentials
# belong to, because a token, an app secret and a verify token from different apps will not work together.
# Location: Meta Developer Dashboard (https://developers.facebook.com/) -> My Apps -> your app -> App Settings -> Basic -> App ID
# Optional. The App ID is not secret.
# META_ANSARI_APP_ID="your_app_id_here"

###################################### Related to Chat Settings ######################################

# When True, every message gets a "down for maintenance" reply and is not processed.
# This is the WhatsApp service's own switch; it does NOT follow apps/api's MAINTENANCE_MODE.
WA_MAINTENANCE_MODE="False"

# Hours of silence after which the next message starts a new thread
WHATSAPP_CHAT_RETENTION_HOURS="3"

# Maximum age in seconds for incoming WhatsApp messages to be processed (24 hours = 86400 seconds).
# Older messages are rejected to avoid answering outdated messages.
WHATSAPP_MESSAGE_AGE_THRESHOLD_SECONDS="86400"

###################################### Related to Test/Development/Logging ######################################

# Optional. Only needed for one manual check: "does Meta really accept a message sent to a BSUID?"
# A BSUID is Meta's per-user ID that replaces the phone number when a user hides it (looks like
# EG.1234567890123456789). You cannot make one up: it must belong to a real WhatsApp user who already messaged
# OUR business number. BSUIDs are per business portfolio, so yours only works with phone numbers owned by the same
# portfolio. Keep it private: never commit it, paste it in an issue or print it in logs.
# REAL_TEST_BSUID=""

# Meta webhook response behavior
# Meta's webhooks require HTTP 200 responses to acknowledge receipt.
# True (production/staging/development/local): always return HTTP 200 to Meta, whatever went wrong inside.
# False (automated tests only): return real status codes (400, 500, ...) so tests can assert on them.
# NOTE: this should ALWAYS be True in production.
ALWAYS_RETURN_OK_TO_META="True"

# Optional. Leave unset for DEBUG when DEPLOYMENT_TYPE=local and INFO everywhere else.
# Accepts DEBUG, INFO, WARNING or ERROR.
# LOGGING_LEVEL="INFO"

###################################### Related to Service Provider Settings ######################################

# If True, use a mock Ansari client instead of real HTTP calls to apps/api. Useful for:
#   - development without apps/api running
#   - unit tests with simulated responses and realistic latency/errors
#   - offline development, and no AI API cost
# Only allowed when DEPLOYMENT_TYPE=local.
MOCK_ANSARI_CLIENT="False"

# If True, use a mock apps/auth client that issues fake tokens instead of calling apps/auth.
# Useful while apps/auth's /whatsapp endpoint is not available. Only allowed when DEPLOYMENT_TYPE=local.
MOCK_AUTH_CLIENT="False"

# Optional, only with MOCK_AUTH_CLIENT=True: a real apps/auth JWT that the mock returns for every BSUID, so a mocked
# sign-in can talk to a real apps/api. Get one by logging in through apps/api (POST /api/v2/users/login).
# Leave unset to get fake tokens (which a real apps/api rejects). Every user would share this one account and
# thread, so the service refuses to start with it unless DEPLOYMENT_TYPE="local".
# MOCK_AUTH_TOKEN=""

# If True, use a mock Meta API service instead of real HTTP calls to Meta's WhatsApp Cloud API. Useful for:
#   - development when Meta credentials are not configured or invalid
#   - testing the webhook flow without sending real WhatsApp messages
#   - avoiding Meta API quota use and not affecting real users
# Only allowed when DEPLOYMENT_TYPE=local.
MOCK_META_API="False"
