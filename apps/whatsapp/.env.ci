# CI dummy environment for apps/whatsapp, mirroring apps/auth/.env.ci. Every value is
# deliberately, obviously fake; no repository secrets. CI loads this file:
#   grep -v '^#' apps/whatsapp/.env.ci >> "$GITHUB_ENV"
# Not auto-loaded by any runtime (only .env is). The tests pass their own environment
# to buildConfig(); these values exist so every variable the service requires is present
# in CI (tests/envTemplates.test.ts checks that this file is a valid configuration).
DEPLOYMENT_TYPE=local
AUTH_WHATSAPP_API_KEY=placeholder-not-a-real-key
META_BUSINESS_PHONE_NUMBER_ID=000000000000000
META_ACCESS_TOKEN_FROM_SYS_USER=placeholder-not-a-real-token
META_WEBHOOK_VERIFY_TOKEN=placeholder-not-a-real-verify-token
META_ANSARI_APP_SECRET=placeholder-not-a-real-app-secret
